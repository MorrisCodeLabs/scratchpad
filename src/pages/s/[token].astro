---
export const prerender = false;
import Base from "@/layouts/Base.astro";
import { SharedNoteView } from "@/components/SharedNoteView.tsx";
import { supabase } from "@/lib/supabase";

const { token } = Astro.params;

const { data, error } = await supabase.rpc("consume_share_view", { p_token: token });
const row = data?.[0];

if (error || !row) {
  return new Response(null, { status: 404 });
}
---

<Base>
  {
    row.out_already_viewed ? (
      <div class="flex h-screen w-screen flex-col items-center justify-center gap-2 bg-bg px-6 text-center text-ink">
        <p class="text-lg font-semibold">This link has already been viewed</p>
        <p class="max-w-sm text-sm text-muted">
          “{row.out_title}” was shared as a one-time link and can no longer be opened.
        </p>
      </div>
    ) : (
      <SharedNoteView client:load title={row.out_title} content={row.out_content} updatedAt={row.out_updated_at} />
    )
  }
</Base>
