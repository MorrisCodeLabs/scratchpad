# Supabase project credentials (Settings -> API in the Supabase dashboard).
# Copy this file to .env and fill in your own project's values.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings -> API -> service_role) — server-only, used by
# the Stripe API routes to update a workspace's plan. Never expose this to
# the client (no PUBLIC_ prefix, and never imported from client code).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Workbench -> API keys, and each Price's own page for its ID).
# Secret key and webhook secret are server-only; the publishable key is
# meant to be public.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
