# Supabase project credentials (Settings -> API in the Supabase dashboard).
# Copy this file to .env and fill in your own project's values.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" and redeploy to lock everyone but the app owner
# (OWNER_EMAIL in src/lib/use-plan.ts) out of the app.
PUBLIC_MAINTENANCE_MODE=false
